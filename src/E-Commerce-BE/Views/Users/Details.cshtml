@model ApplicationUser
@{
    ViewData["Title"] = "User Details";

    var roleBadges = new Dictionary<string, string>
    {
        { "admin", "badge-danger" },
        { "seller", "badge-warning" },
        { "client", "badge-info" }
    };

    string GetRoleBadge(IList<string> roles)
    {
        if (roles.Contains("admin")) return roleBadges["admin"];
        if (roles.Contains("seller")) return roleBadges["seller"];
        if (roles.Contains("client")) return roleBadges["client"];
        return "badge-secondary";
    }

    var currentRoles = ViewBag.Roles as IList<string> ?? new List<string>();
}

<div class="container mx-auto p-4 md:p-8 max-w-4xl">
    <div class="text-center mb-12">
        <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-6xl animate-fade-in-down">
            <i class="bi bi-person-badge"></i> User Details
        </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- User Details -->
        <div class="lg:col-span-2 card p-8">
            <h4 class="text-2xl font-bold text-white mb-6">Account Information</h4>
            <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <span class="font-semibold text-gray-400">First Name</span>
                    <span class="md:col-span-2 text-white">@Model.FirstName</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <span class="font-semibold text-gray-400">Last Name</span>
                    <span class="md:col-span-2 text-white">@Model.LastName</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <span class="font-semibold text-gray-400">Email</span>
                    <span class="md:col-span-2 text-white">@Model.Email</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <span class="font-semibold text-gray-400">Phone</span>
                    <span class="md:col-span-2 text-white">@Model.PhoneNumber</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <span class="font-semibold text-gray-400">Address</span>
                    <span class="md:col-span-2 text-white">@Model.Address</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <span class="font-semibold text-gray-400">Created At</span>
                    <span class="md:col-span-2 text-white">@Model.CreateAt.ToString("f")</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                    <span class="font-semibold text-gray-400">Role</span>
                    <div class="md:col-span-2">
                        <span class="badge @GetRoleBadge(currentRoles)">@string.Join(", ", currentRoles)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="space-y-8">
            <div class="card p-6">
                <h4 class="text-2xl font-bold text-white mb-4">Manage Role</h4>
                <form method="post" asp-controller="Users" asp-action="EditRole">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="space-y-4">
                        <div>
                            <label for="role-select" class="form-label">Assign new role</label>
                            <select class="form-input" name="newRole" id="role-select" asp-items="@ViewBag.SelectItems"></select>
                        </div>
                        <button type="submit" class="btn btn-primary w-full">
                            <i class="bi bi-shield-lock-fill"></i> Update Role
                        </button>
                    </div>
                </form>
            </div>

            <div class="card p-6">
                <h4 class="text-2xl font-bold text-white mb-4">Account Actions</h4>
                <div class="space-y-4">
                    <a class="btn btn-danger w-full" asp-controller="Users" asp-action="DeleteAccount" asp-route-id="@Model.Id" onclick="return confirm('Are you sure you want to permanently delete this user? This action is irreversible.')">
                        <i class="bi bi-trash-fill"></i> Delete User
                    </a>
                    <a class="btn btn-secondary w-full" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

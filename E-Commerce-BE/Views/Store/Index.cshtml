@model StoreSearchModel
@{
    ViewData["Title"] = "Store";
}

<div class="bg-gradient-to-r from-black via-gray-900 to-black text-gray-300 min-h-screen p-8">
    <div class="container mx-auto">
        <h2 class="text-4xl font-bold text-center text-white mb-8">Our Products</h2>

        <form class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 p-6 bg-gray-800/50 rounded-lg border border-gray-700">
            <div>
                <select class="w-full bg-gray-900 border border-gray-700 rounded-lg py-2 px-4 text-white focus:outline-none focus:border-brand-amber" name="brand" asp-for="Brand" onchange="this.form.submit()">
                    <option value="">All Brands</option>
                    <option value="Samsung">Samsung</option>
                    <option value="Apple">Apple</option>
                    <option value="Nokia">Nokia</option>
                    <option value="HP">HP</option>
                </select>
            </div>
            <div>
                <select class="w-full bg-gray-900 border border-gray-700 rounded-lg py-2 px-4 text-white focus:outline-none focus:border-brand-amber" name="category" asp-for="Category" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    <option value="Phones">Phones</option>
                    <option value="Computers">Computers</option>
                    <option value="Accessories">Accessories</option>
                    <option value="Printers">Printers</option>
                    <option value="Cameras">Cameras</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div>
                <select class="w-full bg-gray-900 border border-gray-700 rounded-lg py-2 px-4 text-white focus:outline-none focus:border-brand-amber" name="sort" asp-for="Sort" onchange="this.form.submit()">
                    <option value="newest">Order By Newest</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                </select>
            </div>
            <div class="flex">
                <input class="w-full bg-gray-900 border border-gray-700 rounded-l-lg py-2 px-4 text-white focus:outline-none focus:border-brand-amber" name="search" asp-for="Search" placeholder="Search by Name">
                <button class="bg-brand-amber hover:bg-amber-600 text-white font-bold py-2 px-4 rounded-r-lg" type="submit">Search</button>
            </div>
        </form>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            @foreach (var product in ViewBag.Products)
            {
                <div class="bg-gray-800/50 rounded-lg shadow-lg overflow-hidden transform hover:scale-105 transition-transform duration-300 border border-gray-700 hover:border-brand-amber">
                    <div class="p-6">
                        <img src="/products/@product.ImageFileName" class="w-full h-48 object-contain rounded-lg" alt="@product.Name" />
                    </div>
                    <div class="p-6 bg-gray-900/70">
                        <h5 class="text-xl font-bold text-white mb-2">@product.Name</h5>
                        <p class="text-gray-400 text-sm mb-4">
                            Brand: @product.Brand, Category: @product.Category
                        </p>
                        <div class="text-2xl font-bold text-brand-amber mb-4">@product.Price.ToString("C")</div>
                        <div class="flex flex-col space-y-2">
                            <a class="bg-gray-700 hover:bg-gray-600 text-white text-center py-2 rounded-lg transition-colors" asp-controller="Store"
                               asp-action="Details" asp-route-id="@product.Id" role="button">Details</a>
                            <button type="button" class="bg-brand-amber hover:bg-amber-600 text-white py-2 rounded-lg transition-colors" onclick="addToCart(this, @product.Id)">
                                Add to Cart <i class="bi bi-cart4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <nav class="mt-8">
            <ul class="flex justify-center space-x-2">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    string activeClass = i == ViewBag.PageIndex ? "bg-brand-amber text-white" : "bg-gray-800 text-gray-300 hover:bg-gray-700";
                    <li class="page-item">
                        <a class="page-link px-4 py-2 rounded-lg transition-colors @activeClass" asp-route-pageIndex="@i"
                           asp-route-search="@Model.Search" asp-route-brand="@Model.Brand"
                           asp-route-category="@Model.Category" asp-route-sort="@Model.Sort">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
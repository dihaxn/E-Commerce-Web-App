@model Product

<div class="container mx-auto px-4 py-12">
    <div class="card">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center p-8">
            <!-- Product Image -->
            <div class="rounded-xl overflow-hidden">
                <img src="/products/@Model.ImageFileName" class="w-full h-auto object-contain" alt="@Model.Name" />
            </div>

            <!-- Product Details -->
            <div>
                <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight">@Model.Name</h1>

                <div class="flex items-center space-x-4 mb-6">
                    <span class="text-4xl font-bold text-amber-400">@Model.Price.ToString("C")</span>
                    <span class="badge badge-success">In Stock</span>
                </div>

                <div class="space-y-4 text-gray-300 mb-8">
                    <div class="flex items-center">
                        <span class="font-semibold text-gray-400 w-24">Brand:</span>
                        <span>@Model.Brand</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-semibold text-gray-400 w-24">Category:</span>
                        <span class="badge badge-info">@Model.Category</span>
                    </div>
                </div>

                <div class="prose prose-invert max-w-none text-gray-400 mb-8" style="white-space: pre-line">
                    @Model.Description
                </div>

                <button type="button" class="btn btn-primary btn-lg w-full" onclick="addToCart(this, @Model.Id)">
                    <i class="bi bi-cart-plus-fill"></i>
                    Add to Cart
                </button>
            </div>
        </div>
    </div>
</div>
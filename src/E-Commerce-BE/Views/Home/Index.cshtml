@{
    ViewData["Title"] = "Home Page";
}
@model IEnumerable<Product>

@section Styles {
    <style>
        .hero-bg {
            background-color: #0a0f1d;
            background-image:
                radial-gradient(at 15% 20%, hsla(27, 90%, 55%, 0.25) 0px, transparent 50%),
                radial-gradient(at 80% 70%, hsla(212, 90%, 55%, 0.15) 0px, transparent 50%);
            overflow: hidden;
        }

        .gradient-headline {
            background: linear-gradient(90deg, #f59e0b, #fcd34d, #fbbf24);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmer 3s ease-in-out infinite;
        }

        @@keyframes shimmer {
            0%, 100% { background-position: 200% 0; }
            50% { background-position: -200% 0; }
        }

        /* Animation for the floating hero images */
        @@keyframes float-up-down {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .hero-image-main {
            animation: float-up-down 6s ease-in-out infinite;
        }
        .hero-image-accent {
            animation: float-up-down 8s ease-in-out infinite 1s; /* delayed start */
        }
    </style>
}

<div class="hero-bg">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center min-h-[85vh]">
            
            <div class="text-center lg:text-left animate-fade-in-up">
                <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight">
                    <span class="text-white">Discover Innovation,</span><br/>
                    <span class="gradient-headline">Delivered.</span>
                </h1>
                <p class="mt-6 text-lg sm:text-xl text-gray-400 max-w-lg mx-auto lg:mx-0">
                    Welcome to Best Store, your ultimate destination for premium electronics. Quality products, unbeatable prices, and exceptional service.
                </p>
                <div class="mt-10 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                    <a class="btn btn-primary btn-lg w-full sm:w-auto" asp-controller="Store" asp-action="Index">
                        <i class="bi bi-lightning-charge-fill mr-2"></i> Explore Products
                    </a>
                    <a class="btn btn-outline btn-lg w-full sm:w-auto" asp-controller="Home" asp-action="AboutUs">
                        Learn More <i class="bi bi-arrow-right ml-2"></i>
                    </a>
                </div>
            </div>

            <div class="hidden lg:flex items-center justify-center h-full relative animate-fade-in-down">
                <div class="absolute w-[600px] h-[600px] bg-amber-500/10 rounded-full blur-3xl"></div>
                
                <img src="/images/hero-main-product.png" alt="Featured Product" 
                     class="w-full max-w-lg hero-image-main z-10 drop-shadow-2xl" />
                <img src="/images/hero-accent-product.png" alt="Accent Product"
                     class="absolute w-48 -bottom-8 -left-8 hero-image-accent z-10 drop-shadow-xl" />
            </div>

        </div>
    </div>
</div>

<div class="bg-gray-900/50">
    <div class="container mx-auto px-4 py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
            <div class="flex flex-col items-center">
                <div class="feature-icon">
                    <i class="bi bi-truck text-3xl"></i>
                </div>
                <h3 class="mt-4 text-xl font-bold text-white">Fast & Free Shipping</h3>
                <p class="mt-2 text-gray-400">Reliable, free shipping on all orders over $50, delivered right to your door.</p>
            </div>
            <div class="flex flex-col items-center">
                <div class="feature-icon">
                    <i class="bi bi-shield-check text-3xl"></i>
                </div>
                <h3 class="mt-4 text-xl font-bold text-white">Secure Payments</h3>
                <p class="mt-2 text-gray-400">Your transactions are safe with our 256-bit SSL encrypted payment gateway.</p>
            </div>
            <div class="flex flex-col items-center">
                <div class="feature-icon">
                    <i class="bi bi-headset text-3xl"></i>
                </div>
                <h3 class="mt-4 text-xl font-bold text-white">24/7 Support</h3>
                <p class="mt-2 text-gray-400">Our dedicated support team is here to help you around the clock.</p>
            </div>
        </div>
    </div>
</div>

<div class="py-20">
    <div class="container mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-4xl sm:text-5xl font-extrabold text-white">Our Best Sellers</h2>
            <p class="mt-4 text-lg text-gray-400">Discover products that our customers love the most.</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                @foreach (var product in Model)
                {
                    <div class="group relative bg-white/5 border border-white/10 rounded-2xl p-6 flex flex-col backdrop-blur-xl transition-all duration-300 hover:border-amber-500/50 hover:-translate-y-2">
                        <div class="relative flex-shrink-0">
                            <a asp-controller="Store" asp-action="Details" asp-route-id="@product.Id">
                                <img src="/products/@product.ImageFileName" class="w-full h-48 object-contain transition-transform duration-300 group-hover:scale-105"
                                     alt="@product.Name" />
                            </a>
                        </div>
                        <div class="pt-6 flex flex-col flex-grow">
                            <p class="text-amber-400 text-xs font-semibold mb-2">@product.Category</p>
                            <h5 class="text-lg font-bold text-white mb-2 flex-grow">@product.Name</h5>
                            <div class="text-2xl font-bold text-white mb-4">@product.Price.ToString("C")</div>
                            <div class="flex flex-col space-y-2 mt-auto">
                                <a class="btn btn-outline" asp-controller="Store" asp-action="Details" asp-route-id="@product.Id">
                                    <i class="bi bi-info-circle-fill"></i> Details
                                </a>
                                @if (User.IsInRole("client"))
                                {
                                    <button type="button" class="btn btn-primary" onclick="addToCart(this, @product.Id)">
                                        <i class="bi bi-cart-plus-fill"></i> Add to Cart
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-center text-gray-400">Featured products are not available at the moment.</p>
        }
    </div>
</div>

<div class="bg-gray-900/50">
    <div class="container mx-auto px-4 py-20 text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Ready to Find Your Next Favorite Gadget?</h2>
        <p class="mt-4 text-lg text-gray-400 max-w-2xl mx-auto">
            Browse our full collection of cutting-edge electronics and find the perfect product to fit your lifestyle.
        </p>
        <div class="mt-8">
            <a class="btn btn-primary btn-lg" asp-controller="Store" asp-action="Index">
                Shop All Products
            </a>
        </div>
    </div>
</div>
@model CheckoutDto
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="bg-gradient-to-r from-black via-gray-900 to-black text-white min-h-screen p-4 md:p-8">
    <div class="container mx-auto">
        <h2 class="text-4xl font-bold text-center text-white mb-8">Your Shopping Cart</h2>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Cart Items -->
            <div class="lg:col-span-2 bg-gray-800/50 p-6 rounded-lg border border-gray-700">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="bg-yellow-500/20 text-yellow-300 p-4 rounded-lg mb-6 border border-yellow-500/50">
                        <strong>@ViewBag.ErrorMessage</strong>
                    </div>
                }

                <div class="space-y-6">
                    @foreach (var item in ViewBag.CartItems)
                    {
                        <div class="flex flex-col md:flex-row items-center bg-gray-900/70 p-4 rounded-lg border border-gray-700 hover:border-brand-amber transition-colors">
                            <img src="/products/@item.Product.ImageFileName" width="120" class="rounded-lg mb-4 md:mb-0" alt="...">
                            <div class="md:ml-6 flex-grow text-center md:text-left">
                                <h4 class="text-xl font-bold text-white">@item.Product.Name</h4>
                                <p class="text-gray-400 text-sm">
                                    Brand: @item.Product.Brand | Category: @item.Product.Category
                                </p>
                                <p class="text-lg font-semibold text-brand-amber mt-2">@item.Product.Price.ToString("C")</p>
                            </div>
                            <div class="flex items-center my-4 md:my-0 md:mx-6">
                                <button type="button" class="bg-gray-700 hover:bg-gray-600 text-white font-bold py-1 px-3 rounded-l" onclick="decrease(@item.Product.Id)">-</button>
                                <span class="bg-gray-800 py-1 px-4">@item.Quantity</span>
                                <button type="button" class="bg-gray-700 hover:bg-gray-600 text-white font-bold py-1 px-3 rounded-r" onclick="increase(@item.Product.Id)">+</button>
                            </div>
                            <div class="text-xl font-bold text-white w-24 text-center">@((item.UnitPrice * item.Quantity).ToString("C"))</div>
                            <button class="text-red-500 hover:text-red-400 ml-6" onclick="remove(@item.Product.Id)">
                                <i class="bi bi-trash-fill text-2xl"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Summary -->
            <div class="bg-gray-800/50 p-6 rounded-lg border border-gray-700 h-fit">
                <h4 class="text-2xl font-bold text-white mb-4">Order Summary</h4>
                <hr class="border-gray-700 mb-4" />

                @using Microsoft.AspNetCore.Identity
                @inject SignInManager<ApplicationUser> SignInManager

                @if (!SignInManager.IsSignedIn(User))
                {
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-gray-400">Subtotal:</span>
                        <span class="text-xl font-bold text-white">@ViewBag.Subtotal.ToString("C")</span>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <a class="bg-brand-amber hover:bg-amber-600 text-white text-center font-bold py-2 px-4 rounded-lg transition-colors" asp-controller="Account" asp-action="Register">Register</a>
                        <a class="bg-gray-700 hover:bg-gray-600 text-white text-center font-bold py-2 px-4 rounded-lg transition-colors" asp-controller="Account" asp-action="Login">Login</a>
                    </div>
                }
                else
                {
                    <form method="post">
                        <div class="mb-4">
                            <label class="block text-gray-400 mb-2" asp-for="DeliveryAddress">Delivery Address</label>
                            <input type="text" class="w-full bg-gray-900 border border-gray-700 rounded-lg py-2 px-4 text-white focus:outline-none focus:border-brand-amber" asp-for="DeliveryAddress">
                            <span asp-validation-for="DeliveryAddress" class="text-red-500 text-sm mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label class="block text-gray-400 mb-2" asp-for="PaymentMethod">Payment Method</label>
                            <select class="w-full bg-gray-900 border border-gray-700 rounded-lg py-2 px-4 text-white focus:outline-none focus:border-brand-amber" asp-for="PaymentMethod">
                                <option value="cash">Cash on Delivery</option>
                                <option value="credit_card">Credit Card</option>
                                <option value="paypal">Paypal</option>
                            </select>
                        </div>

                        <hr class="border-gray-700 my-4">

                        <div class="space-y-2">
                            <div class="flex justify-between">
                                <span class="text-gray-400">Subtotal:</span>
                                <span class="font-semibold text-white">@ViewBag.Subtotal.ToString("C")</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-400">Shipping:</span>
                                <span class="font-semibold text-white">@ViewBag.ShippingFee.ToString("C")</span>
                            </div>
                            <div class="flex justify-between text-xl font-bold">
                                <span class="text-white">Total:</span>
                                <span class="text-brand-amber">@ViewBag.Total.ToString("C")</span>
                            </div>
                        </div>

                        <div class="mt-6">
                            <button class="w-full bg-brand-amber hover:bg-amber-600 text-white font-bold py-3 rounded-lg transition-colors" type="submit">Proceed to Checkout</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
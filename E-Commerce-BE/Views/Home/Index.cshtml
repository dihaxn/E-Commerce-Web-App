@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}

<style>
    /* CSS Custom Properties for Theming */
    :root {
        --font-family-sans: 'Poppins', sans-serif;
        --brand-amber: #f59e0b;
        --brand-amber-dark: #d97706;
        --brand-blue-dark: #1e3a8a;
        --brand-blue-light: #2563eb;
        --gray-darkest: #111827;
        --gray-dark: #1f2937;
        --gray-medium: #374151;
        --gray-light: #4b5563;
        --text-light: #f3f4f6;
        --focus-ring-color: rgba(245, 158, 11, 0.6);
    }

    body {
        font-family: var(--font-family-sans);
        background-color: var(--gray-darkest);
    }

    /* ===== KEYFRAME ANIMATIONS ===== */
    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-50px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(50px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes bounce-gentle {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    @@keyframes pulse-glow-amber {
        0%, 100% {
            box-shadow: 0 0 15px 0px rgba(245, 158, 11, 0.3), 0 0 5px 0px rgba(245, 158, 11, 0.2);
        }

        50% {
            box-shadow: 0 0 30px 5px rgba(245, 158, 11, 0.5), 0 0 10px 2px rgba(245, 158, 11, 0.4);
        }
    }

    /* ===== ANIMATION UTILITY CLASSES ===== */
    .animate-on-scroll {
        opacity: 0; /* Initially hidden */
    }

    .animate-slide-in-left {
        animation: slideInLeft 1s ease-out forwards;
    }

    .animate-slide-in-right {
        animation: slideInRight 1s ease-out forwards;
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .animate-bounce-gentle {
        animation: bounce-gentle 2.5s infinite ease-in-out;
    }

    .animate-pulse-glow-amber {
        animation: pulse-glow-amber 2.5s infinite ease-in-out;
    }

    /* Animation Delays */
    .delay-1 {
        animation-delay: 0.1s;
    }

    .delay-2 {
        animation-delay: 0.2s;
    }

    .delay-3 {
        animation-delay: 0.3s;
    }

    .delay-4 {
        animation-delay: 0.4s;
    }

    .delay-5 {
        animation-delay: 0.5s;
    }

    /* ===== COMPONENT STYLES ===== */
    /* Hero background pattern */
    .hero-pattern {
        background-image: radial-gradient(circle at 25px 25px, rgba(255,255,255,0.05) 2px, transparent 0), radial-gradient(circle at 75px 75px, rgba(255,255,255,0.03) 1px, transparent 0);
        background-size: 100px 100px;
    }

    /* Product card hover effects */
    .product-card {
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid var(--gray-medium);
    }

        .product-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
            border-color: var(--brand-amber);
        }

    /* Button ripple effect (as defined in layout) */
    .btn-ripple {
        position: relative;
        overflow: hidden;
    }

        .btn-ripple::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            transition: width 0.6s, height 0.6s;
            transform: translate(-50%, -50%);
            z-index: 0;
        }

        .btn-ripple:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-ripple > * {
            position: relative;
            z-index: 1;
        }

        /* Accessibility: Focus visible styles */
        .btn-ripple:focus-visible, button:focus-visible, a:focus-visible {
            outline: 2px solid transparent;
            outline-offset: 2px;
            box-shadow: 0 0 0 3px var(--focus-ring-color);
        }
</style>

<section class="bg-gray-900 hero-pattern relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/50 via-gray-900 to-black opacity-60"></div>
    <div class="container mx-auto px-6 py-20 lg:py-28 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12">
            <div class="lg:w-1/2 text-white text-center lg:text-left">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 animate-on-scroll animate-slide-in-left">
                    <span class="block tracking-tight">The Future of Tech</span>
                    <span class="block bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-brand-amber mt-2">Is Here</span>
                </h1>
                <p class="text-lg lg:text-xl text-gray-300 leading-relaxed max-w-xl mx-auto lg:mx-0 animate-on-scroll animate-slide-in-left delay-2">
                    Discover a universe of cutting-edge electronics. From powerful laptops to immersive entertainment systems, find it all at unbeatable prices.
                </p>
                <div class="mt-10 animate-on-scroll animate-slide-in-left delay-3">
                    <a href="#products" class="inline-block bg-brand-amber hover:bg-amber-500 text-gray-900 font-bold px-8 py-4 rounded-full transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-amber-500/30 btn-ripple animate-pulse-glow-amber">
                        <span class="flex items-center"><i class="bi bi-rocket-takeoff-fill mr-2"></i>Explore Now</span>
                    </a>
                </div>
            </div>

            <div class="lg:w-1/2 text-center animate-on-scroll animate-slide-in-right delay-4">
                <div class="relative inline-block">
                    <img src="/images/hero.png" class="relative z-10 max-w-full h-auto transform hover:scale-105 transition-transform duration-500 animate-bounce-gentle" alt="Assortment of modern electronic devices" />
                </div>
            </div>
        </div>
    </div>
</section>

<section id="products" class="bg-gradient-to-b from-gray-900 to-black py-16 lg:py-24">
    <div class="container mx-auto px-4">
        <div class="text-center mb-14">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 animate-on-scroll animate-fade-in-up">
                Newest Arrivals
            </h2>
            <div class="w-28 h-1 bg-gradient-to-r from-brand-amber to-amber-500 mx-auto rounded-full animate-on-scroll animate-fade-in-up delay-1"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">
            @{
                string[] delays = { "delay-1", "delay-2", "delay-3", "delay-4" };
                int cardIndex = 0;
            }
            @foreach (var product in Model)
            {
                <div class="product-card rounded-2xl shadow-lg h-full flex flex-col animate-on-scroll animate-fade-in-up @delays[cardIndex % 4]">
                    <div class="bg-gray-800 rounded-t-2xl overflow-hidden group">
                        <div class="relative p-4 bg-black/20">
                            <div class="aspect-square flex items-center justify-center overflow-hidden rounded-xl">
                                <img src="/products/@product.ImageFileName" class="w-full h-full object-contain transform group-hover:scale-110 transition-transform duration-500 ease-in-out" alt="@product.Name" />
                            </div>
                        </div>

                        <div class="p-6 flex-1 flex flex-col bg-gray-800 rounded-b-2xl">
                            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-brand-amber transition-colors duration-300 line-clamp-2 leading-tight">
                                @product.Name
                            </h3>
                            <p class="text-sm text-gray-400 mb-4">
                                By <span class="font-medium text-gray-300">@product.Brand</span>
                            </p>

                            <div class="my-auto pt-2 pb-4">
                                <span class="text-3xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-brand-amber">
                                    $@product.Price.ToString("N2")
                                </span>
                            </div>

                            <div class="mt-auto space-y-3">
                                <a class="block w-full bg-gray-700 btn-ripple text-white text-center py-3 rounded-xl font-semibold transition-all duration-300 hover:bg-gray-600 transform hover:-translate-y-1" asp-controller="Store" asp-action="Details" asp-route-id="@product.Id">
                                    <i class="bi bi-eye mr-2"></i>View Details
                                </a>
                                <button type="button" class="w-full bg-gradient-to-r from-brand-amber to-amber-600 btn-ripple text-black py-3 rounded-xl font-bold transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/20 transform hover:-translate-y-1" onclick="addToCart(this, @product.Id)">
                                    <span class="flex items-center justify-center">
                                        <span class="button-text">Add to Cart</span>
                                        <i class="bi bi-cart-plus ml-2 text-lg"></i>
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                cardIndex++;
            }
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // =======================================================
        //  INTERSECTION OBSERVER FOR SCROLL-IN ANIMATIONS
        //  This triggers animations only when elements are visible,
        //  improving performance.
        // =======================================================
        const observerOptions = {
            threshold: 0.1, // Trigger when 10% of the element is visible
            rootMargin: '0px 0px -50px 0px' // Start loading 50px before it's in view
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Add animation classes from the element's data attributes
                    const animationClasses = entry.target.className.split(' ').filter(c => c.startsWith('animate-'));
                    entry.target.classList.add(...animationClasses);

                    // Element is now animated, no need to observe it anymore
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // Observe all elements with the 'animate-on-scroll' class
        const animatedElements = document.querySelectorAll('.animate-on-scroll');
        animatedElements.forEach(el => {
            observer.observe(el);
        });

        // =======================================================
        //  PARALLAX SCROLL EFFECT FOR HERO IMAGE
        //  A subtle effect for a more dynamic feel.
        // =======================================================
        const heroImage = document.querySelector('.animate-bounce-gentle');
        if (heroImage) {
            window.addEventListener('scroll', () => {
                const scrolled = window.pageYOffset;
                // Apply a gentle vertical movement. The division factor controls the speed.
                heroImage.style.transform = `translateY(${scrolled * 0.1}px)`;
            }, { passive: true }); // Use passive listener for better scroll performance
        }
    });

    // NOTE: The cart functions (addToCart, getShoppingCart, saveCart) are intentionally
    // omitted from this file. They should be defined globally in your main layout
    // or a shared `site.js` file to avoid code duplication. The `onclick` event on
    // the buttons will call those global functions.
</script>
@model LoginDto
@{
    ViewData["Title"] = "Login";
}

<div class="mx-auto max-w-md my-12 p-4 sm:p-6 lg:p-8">
    <div class="card">
        <div class="bg-gradient-to-r from-amber-500 to-amber-600 p-6 text-center">
            <h1 class="text-3xl font-bold text-white tracking-wider flex items-center justify-center gap-3">
                <i class="bi bi-box-arrow-in-right"></i><span>Welcome Back</span>
            </h1>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="m-8 mb-0 bg-red-500/10 text-red-500 p-3 rounded-lg text-center" role="alert">
                <strong>@ViewBag.ErrorMessage</strong>
            </div>
        }

        <div class="p-8">
            <form method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 bg-red-500/10 p-3 rounded-lg" role="alert">
                </div>

                <div>
                    <label asp-for="Email" class="form-label">Email Address*</label>
                    <input asp-for="Email" class="form-input" placeholder="Enter your email">
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="Password" class="form-label">Password*</label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="Enter your password">
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input asp-for="RememberMe" type="checkbox"
                            class="h-4 w-4 rounded border-gray-600 bg-gray-800 text-amber-600 focus:ring-amber-500">
                        <label asp-for="RememberMe" class="ml-2 block text-sm text-gray-300">Remember me</label>
                    </div>
                    <a asp-controller="Account" asp-action="ForgotPassword"
                        class="text-sm text-amber-500 hover:text-amber-400 transition-colors">
                        Forgot your password?
                    </a>
                </div>

                <div class="pt-6 space-y-4">
                    <button type="submit" class="btn btn-primary w-full">
                        <i class="bi bi-box-arrow-in-right"></i>Log In
                    </button>

                    <div class="flex items-center my-6">
                        <div class="flex-grow border-t border-gray-700"></div>
                        <span class="mx-4 text-gray-500 text-sm">or</span>
                        <div class="flex-grow border-t border-gray-700"></div>
                    </div>

                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline w-full">
                        <i class="bi bi-person-plus-fill"></i>Create an Account
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
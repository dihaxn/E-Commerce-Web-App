                            <div class="p-2 bg-brand-amber/10 rounded-lg border border-brand-amber/30"><i class="bi bi-shield-check text-green-400 text-xl"></i></div>
                            <span class="text-sm">256-bit SSL Encryption</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-800 text-center text-gray-500 text-sm">
                <div class="flex flex-col md:flex-row justify-between items-center">
                    <div class="flex items-center space-x-2">
                        <img src="/images/icon.png" alt="Best Store Icon" width="20" class="filter brightness-50" />
                        <span>&copy; 2024 - Best Store - </span>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-brand-amber transition-colors">Privacy</a>
                    </div>
                    <div class="mt-4 md:mt-0 flex space-x-6">
                        <a href="#" class="hover:text-brand-amber transition-colors">Terms of Service</a>
                        <a href="#" class="hover:text-brand-amber transition-colors">Returns & Exchanges</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
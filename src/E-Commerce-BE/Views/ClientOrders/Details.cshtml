@model Order
@{
    ViewData["Title"] = "Order Details";

    var paymentBadges = new Dictionary<string, string>
    {
        { "pending", "badge-warning" },
        { "accepted", "badge-success" },
        { "canceled", "badge-secondary" }
    };
    string GetPaymentBadge(string status) => paymentBadges.GetValueOrDefault(status, "badge-secondary");

    var orderBadges = new Dictionary<string, string>
    {
        { "created", "badge-warning" },
        { "accepted", "badge-success" },
        { "shipped", "badge-info" },
        { "delivered", "badge-success" },
        { "returned", "badge-secondary" },
        { "canceled", "badge-danger" }
    };
    string GetOrderBadge(string status) => orderBadges.GetValueOrDefault(status, "badge-secondary");
}

@section Styles {
    <style>
        .badge {
            display: inline-block;
            padding: 0.35em 0.65em;
            font-size: .75em;
            font-weight: 700;
            line-height: 1;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.375rem;
            text-transform: capitalize;
        }

        .badge-success { background-color: rgba(34, 197, 94, 0.2); color: #22c55e; }
        .badge-warning { background-color: rgba(245, 158, 11, 0.2); color: #f59e0b; }
        .badge-danger { background-color: rgba(239, 68, 68, 0.2); color: #ef4444; }
        .badge-info { background-color: rgba(59, 130, 246, 0.2); color: #3b82f6; }
        .badge-secondary { background-color: rgba(107, 114, 128, 0.2); color: #6b7280; }
    </style>
}

<div class="container mx-auto p-4 md:p-8">
    <a class="btn btn-outline mb-8 inline-flex items-center" asp-controller="ClientOrders" asp-action="Index">
        <i class="bi bi-arrow-left mr-2"></i> Back to Orders
    </a>

    <div class="text-center mb-12">
        <!-- This heading is already responsive -->
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white">Order Details</h1>
    </div>

    <div class="bg-gray-900/70 border border-white/10 rounded-2xl p-6 md:p-8 backdrop-blur-xl">
        <h4 class="text-2xl font-bold text-white mb-6">Order Information</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 text-gray-300">
            <div class="flex flex-col sm:flex-row"><span class="font-semibold text-gray-400 w-full sm:w-36 flex-shrink-0">Order ID:</span> <span class="text-white">@Model.Id</span></div>
            <div class="flex flex-col sm:flex-row"><span class="font-semibold text-gray-400 w-full sm:w-36 flex-shrink-0">Order Date:</span> <span class="text-white">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span></div>
            <div class="flex flex-col sm:flex-row"><span class="font-semibold text-gray-400 w-full sm:w-36 flex-shrink-0">Payment Method:</span> <span class="text-white">@Model.PaymentMethod</span></div>
            <div class="flex flex-col sm:flex-row"><span class="font-semibold text-gray-400 w-full sm:w-36 flex-shrink-0">Delivery Address:</span> <span class="text-white">@Model.DeliveryAddress</span></div>
            <div class="flex items-center"><span class="font-semibold text-gray-400 w-full sm:w-36 flex-shrink-0">Payment Status:</span>
                <span class="badge @GetPaymentBadge(Model.PaymentStatus)">@Model.PaymentStatus</span>
            </div>
            <div class="flex items-center"><span class="font-semibold text-gray-400 w-full sm:w-36 flex-shrink-0">Order Status:</span>
                <span class="badge @GetOrderBadge(Model.OrderStatus)">@Model.OrderStatus</span>
            </div>
        </div>
    </div>

    <div class="mt-12 grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        <div class="bg-gray-900/70 border border-white/10 rounded-2xl shadow-lg backdrop-blur-xl lg:col-span-2">
            <!-- CHANGED: Added a wrapper div to allow horizontal scrolling on mobile -->
            <div class="overflow-x-auto">
                <!-- CHANGED: Added a min-width to prevent the table from collapsing too much -->
                <table class="table w-full text-left text-gray-300 min-w-[700px]">
                    <thead class="bg-gray-800/50 text-gray-400 uppercase text-sm">
                        <tr>
                            <th class="p-4 whitespace-nowrap" colspan="2">Product</th>
                            <th class="p-4 text-center whitespace-nowrap">Units</th>
                            <th class="p-4 text-right whitespace-nowrap">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal subtotal = 0;
                            foreach (var item in Model.Items)
                            {
                                subtotal += item.UnitPrice * item.Quantity;
                                <tr class="border-b border-gray-700 last:border-b-0">
                                    <td class="p-4 w-24">
                                        <img src="/products/@item.Product.ImageFileName" class="rounded-lg w-20 h-20 object-contain" alt="@item.Product.Name" />
                                    </td>
                                    <td class="p-4">
                                        <a class="text-white hover:text-amber-400 font-semibold" asp-controller="Store"
                                           asp-action="Details" asp-route-id="@item.Product.Id">
                                            @item.Product.Name
                                        </a>
                                        <div class="text-sm text-gray-400">@item.Product.Category</div>
                                        <div class="text-sm text-gray-500">@item.UnitPrice.ToString("C")</div>
                                    </td>
                                    <td class="p-4 text-center">@item.Quantity</td>
                                    <td class="p-4 text-right font-semibold text-white whitespace-nowrap">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="w-full bg-gray-900/70 border border-white/10 rounded-2xl p-6 backdrop-blur-xl">
            <h4 class="text-xl font-bold text-white mb-4">Order Summary</h4>
            <div class="space-y-3">
                <div class="flex justify-between">
                    <span class="font-semibold text-gray-400">Subtotal:</span>
                    <span class="text-white">@subtotal.ToString("C")</span>
                </div>
                <div class="flex justify-between">
                    <span class="font-semibold text-gray-400">Shipping Fee:</span>
                    <span class="text-white">@Model.ShippingFee.ToString("C")</span>
                </div>
                <hr class="border-gray-700 my-2" />
                <div class="flex justify-between text-xl font-bold">
                    <span class="text-white">Total:</span>
                    <span class="text-amber-400">@((subtotal + Model.ShippingFee).ToString("C"))</span>
                </div>
            </div>
        </div>
        
    </div>
</div>
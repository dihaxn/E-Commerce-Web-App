@model Product

<div class="bg-gradient-to-r from-black via-gray-900 to-black text-white min-h-screen py-12">
    <div class="container mx-auto px-4">
        <div class="bg-gray-800/50 rounded-2xl shadow-2xl p-8 md:p-12 border border-gray-700">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <!-- Product Image -->
                <div class="product-image-container rounded-xl overflow-hidden cursor-pointer group">
                    <img src="/products/@Model.ImageFileName" class="w-full h-auto object-contain transform group-hover:scale-105 transition-transform duration-500" alt="@Model.Name" />
                    <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                        <i class="bi bi-search text-white text-4xl"></i>
                    </div>
                </div>

                <!-- Product Details -->
                <div>
                    <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight">@Model.Name</h1>
                    
                    <div class="flex items-center space-x-4 mb-6">
                        <span class="text-4xl font-bold text-brand-amber">@Model.Price.ToString("C")</span>
                        <span class="px-4 py-1 bg-green-500/20 text-green-300 rounded-full text-sm font-semibold border border-green-500/50">In Stock</span>
                    </div>

                    <div class="space-y-4 text-gray-300 mb-8">
                        <div class="flex items-center">
                            <span class="font-semibold text-gray-400 w-24">Brand:</span>
                            <span>@Model.Brand</span>
                        </div>
                        <div class="flex items-center">
                            <span class="font-semibold text-gray-400 w-24">Category:</span>
                            <span class="px-3 py-1 bg-brand-amber/20 text-brand-amber rounded-full text-xs font-medium border border-brand-amber/50">@Model.Category</span>
                        </div>
                    </div>

                    <div class="prose prose-invert max-w-none text-gray-400 mb-8" style="white-space: pre-line">
                        @Model.Description
                    </div>

                    <button type="button" class="w-full bg-gradient-to-r from-brand-amber to-amber-600 text-white font-bold py-4 px-8 rounded-xl shadow-lg hover:shadow-amber-500/30 transform hover:-translate-y-1 transition-all duration-300 add-to-cart-btn" onclick="addToCart(this, @Model.Id)">
                        <span class="flex items-center justify-center">
                            <i class="bi bi-cart-plus-fill mr-3 text-xl"></i>
                            <span class="button-text text-lg">Add to Cart</span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Image zoom functionality
    document.querySelector('.product-image-container').addEventListener('click', function() {
        const modal = document.createElement('div');
        modal.style.position = 'fixed';
        modal.style.top = '0';
        modal.style.left = '0';
        modal.style.width = '100%';
        modal.style.height = '100%';
        modal.style.backgroundColor = 'rgba(0,0,0,0.9)';
        modal.style.display = 'flex';
        modal.style.alignItems = 'center';
        modal.style.justifyContent = 'center';
        modal.style.zIndex = '9999';
        modal.style.cursor = 'zoom-out';
        modal.style.transition = 'opacity 0.3s ease';
        modal.style.opacity = '0';

        const img = document.createElement('img');
        img.src = this.querySelector('img').src;
        img.style.maxWidth = '90%';
        img.style.maxHeight = '90%';
        img.style.objectFit = 'contain';
        img.style.borderRadius = '12px';
        img.style.transition = 'transform 0.3s ease';
        img.style.transform = 'scale(0.95)';

        modal.appendChild(img);
        document.body.appendChild(modal);

        // Fade in effect
        setTimeout(() => {
            modal.style.opacity = '1';
            img.style.transform = 'scale(1)';
        }, 10);

        modal.addEventListener('click', function() {
            modal.style.opacity = '0';
            img.style.transform = 'scale(0.95)';
            setTimeout(() => {
                document.body.removeChild(modal);
            }, 300);
        });
    });
</script>
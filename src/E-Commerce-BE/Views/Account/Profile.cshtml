@model ProfileDto
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var appUser = await UserManager.GetUserAsync(User);
    string userRole = "";
    if (User.IsInRole("admin")) userRole = "Admin";
    else if (User.IsInRole("seller")) userRole = "Seller";
    else if (User.IsInRole("client")) userRole = "Client";
}

<div class="container mx-auto p-4 md:p-8">
    <div class="text-center mb-12">
        <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-6xl animate-fade-in-down">
            <i class="bi bi-person-circle"></i> My Profile
        </h1>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success">
            @ViewBag.SuccessMessage
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-1">
            <div class="card p-6">
                <h3 class="card-header">Profile Details</h3>
                <div class="space-y-4 mt-4">
                    <div class="profile-field">
                        <span class="form-label">First Name</span>
                        <p class="form-input-static">@appUser?.FirstName</p>
                    </div>
                    <div class="profile-field">
                        <span class="form-label">Last Name</span>
                        <p class="form-input-static">@appUser?.LastName</p>
                    </div>
                    <div class="profile-field">
                        <span class="form-label">Email</span>
                        <p class="form-input-static">@appUser?.Email</p>
                    </div>
                    <div class="profile-field">
                        <span class="form-label">Phone</span>
                        <p class="form-input-static">@appUser?.PhoneNumber</p>
                    </div>
                    <div class="profile-field">
                        <span class="form-label">Address</span>
                        <p class="form-input-static">@appUser?.Address</p>
                    </div>
                    <div class="profile-field">
                        <span class="form-label">Role</span>
                        <p class="form-input-static">@userRole</p>
                    </div>
                    <div class="profile-field">
                        <span class="form-label">Member Since</span>
                        <p class="form-input-static">@appUser?.CreateAt.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="md:col-span-2">
            <div class="card p-6 mb-8">
                <h3 class="card-header">Edit Profile</h3>
                <form method="post" class="mt-4 space-y-4">
                    <div class="form-group">
                        <label class="form-label" asp-for="FirstName"></label>
                        <input class="form-input" asp-for="FirstName">
                        <span asp-validation-for="FirstName" class="input-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="LastName"></label>
                        <input class="form-input" asp-for="LastName">
                        <span asp-validation-for="LastName" class="input-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Email"></label>
                        <input class="form-input" asp-for="Email">
                        <span asp-validation-for="Email" class="input-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="PhoneNumber"></label>
                        <input class="form-input" asp-for="PhoneNumber">
                        <span asp-validation-for="PhoneNumber" class="input-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Address"></label>
                        <input class="form-input" asp-for="Address">
                        <span asp-validation-for="Address" class="input-error"></span>
                    </div>
                    <div class="flex justify-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <div class="card p-6">
                <h3 class="card-header">Change Password</h3>
                <a class="btn btn-outline mt-4" asp-controller="Account" asp-action="Password">
                    <i class="bi bi-shield-lock"></i> Go to Change Password Page
                </a>
            </div>
        </div>
    </div>
</div>

@using Microsoft.AspNetCore.Html
@model List<Product>
@{
    ViewData["Title"] = "Product Management";
    int pageIndex = (int)ViewData["PageIndex"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    string search = (string)ViewData["Search"]!;
    string column = (string)ViewData["Column"]!;
    string orderBy = (string)ViewData["OrderBy"]!;

    HtmlString GetSortArrow(string tableColumn)
    {
        if (tableColumn != column)
        {
            return new HtmlString("<i class='bi bi-arrow-down-up opacity-50'></i>");
        }
        return orderBy == "desc"
        ? new HtmlString("<i class='bi bi-arrow-down text-amber-400'></i>")
        : new HtmlString("<i class='bi bi-arrow-up text-amber-400'></i>");
    }
}

<div class="container mx-auto p-4 md:p-8">
    <div class="text-center mb-12">
        <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-6xl animate-fade-in-down">
            <i class="bi bi-box-seam"></i> Product Management
        </h1>
    </div>

    <div class="card p-6 mb-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <a class="btn btn-primary w-full md:w-auto" asp-controller="Product" asp-action="Create">
                <i class="bi bi-plus-circle"></i> Add New Product
            </a>
            <form class="w-full md:w-auto md:max-w-xs" role="search">
                <div class="flex">
                    <input class="form-input rounded-r-none" type="search" name="search" value="@search"
                        placeholder="Search products..." aria-label="Search">
                    <button class="btn btn-primary rounded-l-none" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-container bg-gray-900 rounded-lg shadow-lg overflow-hidden">
        <table class="table w-full text-left text-gray-300">
            <thead class="bg-gray-900 text-gray-400 uppercase text-sm">
                <tr>
                    <th class="p-4 cursor-pointer" onclick="sortTable('Id')">ID @GetSortArrow("Id")</th>
                    <th class="p-4 cursor-pointer" onclick="sortTable('Name')">Name @GetSortArrow("Name")</th>
                    <th class="p-4 cursor-pointer" onclick="sortTable('Brand')">Brand @GetSortArrow("Brand")</th>
                    <th class="p-4 cursor-pointer" onclick="sortTable('Category')">Category @GetSortArrow("Category")
                    </th>
                    <th class="p-4 cursor-pointer" onclick="sortTable('Price')">Price @GetSortArrow("Price")</th>
                    <th class="p-4">Image</th>
                    <th class="p-4 cursor-pointer" onclick="sortTable('CreatedAt')">Created At
                        @GetSortArrow("CreatedAt")
                    </th>
                    <th class="p-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr class="border-t border-gray-700 hover:bg-gray-700/50 transition-colors">
                        <td class="p-4">@product.Id</td>
                        <td class="p-4">@product.Name</td>
                        <td class="p-4">@product.Brand</td>
                        <td class="p-4"><span class="badge badge-info">@product.Category</span></td>
                        <td class="p-4 font-semibold">@product.Price.ToString("C")</td>
                        <td class="p-4">
                            <img src="~/products/@product.ImageFileName"
                                class="w-16 h-16 object-contain rounded-lg bg-white/10" alt="@product.Name" />
                        </td>
                        <td class="p-4">@product.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="p-4">
                            <div class="flex items-center gap-2">
                                <a class="btn btn-outline btn-sm" asp-controller="Product" asp-action="Edit"
                                    asp-route-id="@product.Id">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a class="btn btn-danger btn-sm" asp-controller="Product" asp-action="Delete"
                                    asp-route-id="@product.Id"
                                    onclick="return confirm('Are you sure you want to delete this product?')">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="mt-8" aria-label="Page navigation">
        <ul class="flex justify-center items-center space-x-2">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li>
                    <a class="pagination-link @(i == pageIndex ? "pagination-active" : "")" asp-route-pageIndex="@i"
                        asp-route-search="@search" asp-route-column="@column" asp-route-orderBy="@orderBy">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        function sortTable(column) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentColumn = urlParams.get('column');
            const currentOrder = urlParams.get('orderBy');
            let newOrder = 'asc';
            if (column === currentColumn && currentOrder === 'asc') {
                newOrder = 'desc';
            }
            urlParams.set('column', column);
            urlParams.set('orderBy', newOrder);
            window.location.search = urlParams.toString();
        }
    </script>
}
@{
}


<div class="auth-container">
    <div class="card">
        <div class="card-header">
            <h1 class="card-title">
                <i class="bi bi-key"></i> Forgot Password
            </h1>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                @ViewBag.SuccessMessage
            </div>
        }

        <div class="p-8">
            <form method="post" class="space-y-6">
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input class="form-input" name="email" value="@ViewBag.Email"
                        placeholder="Enter your email address" />
                    <span class="input-error">@ViewBag.EmailError</span>
                </div>

                <div class="pt-6 space-y-4">
                    <button type="submit" class="btn btn-primary w-full">
                        <i class="bi bi-send"></i> Send Reset Link
                    </button>
                    <a class="btn btn-outline w-full" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-arrow-left-circle"></i> Back to Login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
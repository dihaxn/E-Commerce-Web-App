@model PasswordResetDto

@{
}

<div class="auth-container">
    <div class="card">
        <div class="card-header">
            <h1 class="card-title">
                <i class="bi bi-unlock"></i> Reset Password
            </h1>
        </div>

        <div class="p-8">
            <div asp-validation-summary="ModelOnly" class="input-error-summary"></div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }
            else if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                    @ViewBag.SuccessMessage
                </div>
            }

            <form method="post" class="space-y-6">
                <input type="hidden" asp-for="Token" />
                <div class="form-group">
                    <label class="form-label" asp-for="Email"></label>
                    <input class="form-input" asp-for="Email" placeholder="Enter your email">
                    <span asp-validation-for="Email" class="input-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Password"></label>
                    <input class="form-input" type="password" asp-for="Password" placeholder="Enter your new password">
                    <span asp-validation-for="Password" class="input-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input class="form-input" type="password" asp-for="ConfirmPassword"
                        placeholder="Confirm your new password">
                    <span asp-validation-for="ConfirmPassword" class="input-error"></span>
                </div>

                <div class="pt-6 space-y-4">
                    <button type="submit" class="btn btn-primary w-full">
                        <i class="bi bi-check-circle"></i> Reset Password
                    </button>
                    <a class="btn btn-outline w-full" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-arrow-left-circle"></i> Back to Login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
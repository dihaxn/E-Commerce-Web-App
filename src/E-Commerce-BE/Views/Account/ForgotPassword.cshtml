@{
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white mb-2">
                <i class="bi bi-lock text-amber-400 mr-2"></i>Forgot Password
            </h1>
            <p class="text-gray-400">Enter your email to receive a password reset link</p>
        </div>

        <div class="card">
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="mb-6 p-4 bg-green-500/20 border border-green-500/30 rounded-lg">
                    <p class="text-green-400 text-sm">@ViewBag.SuccessMessage</p>
                </div>
            }

            <div class="p-8">
                <form method="post" class="space-y-6">
                    <div class="space-y-2">
                        <label class="block text-sm font-medium text-white">Email</label>
                        <input 
                            class="form-input w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 transition-colors" 
                            name="email" 
                            value="@ViewBag.Email"
                            placeholder="Enter your email address" 
                            type="email"
                            required />
                        @if (ViewBag.EmailError != null)
                        {
                            <span class="text-red-400 text-sm">@ViewBag.EmailError</span>
                        }
                    </div>

                    <div class="space-y-4 pt-4">
                        <button type="submit" class="btn btn-primary w-full py-3 text-lg font-medium">
                            <i class="bi bi-send mr-2"></i>Send Reset Link
                        </button>
                        <a class="btn btn-outline w-full py-3 text-lg font-medium" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-arrow-left-circle mr-2"></i>Back to Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
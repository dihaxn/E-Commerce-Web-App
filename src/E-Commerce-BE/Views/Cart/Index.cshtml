@model E_Commerce_BE.Models.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mx-auto p-4 md:p-8">
    <div class="text-center mb-12">
        <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-6xl animate-fade-in-down">
            Shopping Cart
        </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cart Items -->
        <div class="lg:col-span-2">
            <div class="card">
                @* Error message block removed for now, can be re-added if needed *@

                @if (!Model.CartItems.Any())
                {
                    <div class="p-8 text-center">
                        <i class="bi bi-cart-x text-6xl text-gray-600"></i>
                        <h3 class="mt-4 text-2xl font-semibold text-white">Your Cart is Empty</h3>
                        <p class="mt-2 text-gray-400">
                            Looks like you haven't added anything to your cart yet.
                        </p>
                        <a asp-action="Index" asp-controller="Store" class="btn btn-primary mt-6">
                            <i class="bi bi-shop"></i> Start Shopping
                        </a>
                    </div>
                }
                else
                {
                    <div class="space-y-4 p-6">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="flex flex-col md:flex-row items-center bg-gray-900/70 p-4 rounded-lg border border-gray-700 hover:border-amber-500 transition-colors duration-300">
                                <img src="/products/@item.Product.ImageFileName" width="100" class="rounded-lg mb-4 md:mb-0" alt="@item.Product.Name">
                                <div class="md:ml-6 flex-grow text-center md:text-left">
                                    <h4 class="text-xl font-bold text-white">@item.Product.Name</h4>
                                    <p class="text-lg font-semibold text-amber-400 mt-1">@item.Product.Price.ToString("C")</p>
                                </div>
                                <div class="flex items-center my-4 md:my-0 md:mx-6">
                                    <button type="button" class="btn btn-secondary btn-sm rounded-r-none" onclick="decrease(@item.Product.Id)">-</button>
                                    <span class="inline-flex items-center px-4 py-1 border-t border-b border-gray-700 bg-gray-800 text-white">@item.Quantity</span>
                                    <button type="button" class="btn btn-secondary btn-sm rounded-l-none" onclick="increase(@item.Product.Id)">+</button>
                                </div>
                                <div class="text-xl font-bold text-white w-28 text-center">@((item.UnitPrice * item.Quantity).ToString("C"))</div>
                                <button class="btn btn-danger btn-icon ml-4" onclick="remove(@item.Product.Id)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Order Summary -->
        <div class="card h-fit">
            <div class="p-6">
                <h4 class="text-2xl font-bold text-white mb-4">Order Summary</h4>
                <hr class="border-gray-700 mb-4" />

                @using Microsoft.AspNetCore.Identity
                @inject SignInManager<ApplicationUser> SignInManager

                @if (!SignInManager.IsSignedIn(User))
                {
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-gray-400">Subtotal:</span>
                        <span class="text-xl font-bold text-white">@Model.Subtotal.ToString("C")</span>
                    </div>
                    <p class="text-center text-gray-400 mb-4">You need to login to proceed.</p>
                    <div class="grid grid-cols-1 gap-4">
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a class="btn btn-outline" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus-fill"></i> Register
                        </a>
                    </div>
                }
                else
                {
                    <form method="post">
                        <div class="space-y-4">
                            <div>
                                <label class="form-label" asp-for="DeliveryAddress">Delivery Address</label>
                                <input type="text" class="form-input" asp-for="DeliveryAddress">
                                <span asp-validation-for="DeliveryAddress" class="text-red-500 text-xs mt-1"></span>
                            </div>

                            <div>
                                <label class="form-label" asp-for="PaymentMethod">Payment Method</label>
                                <select class="form-input" asp-for="PaymentMethod">
                                    <option value="cash">Cash on Delivery</option>
                                    <option value="credit_card">Credit Card / Debit Card</option>
                                </select>
                            </div>
                        </div>

                        <hr class="border-gray-700 my-6">

                        <div class="space-y-3">
                            <div class="flex justify-between text-gray-300">
                                <span>Subtotal:</span>
                                <span class="font-semibold">@Model.Subtotal.ToString("C")</span>
                            </div>
                            <div class="flex justify-between text-gray-300">
                                <span>Shipping:</span>
                                <span class="font-semibold">@Model.ShippingFee.ToString("C")</span>
                            </div>
                            <div class="flex justify-between text-xl font-bold text-white">
                                <span>Total:</span>
                                <span class="text-amber-400">@Model.Total.ToString("C")</span>
                            </div>
                        </div>

                        <div class="mt-6">
                            <button class="btn btn-primary btn-lg w-full" type="submit">
                                <i class="bi bi-shield-check-fill"></i> Proceed to Checkout
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
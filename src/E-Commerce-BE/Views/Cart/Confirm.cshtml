@{
    ViewData["Title"] = "Confirm Order";
}

<div class="flex items-center justify-center p-4 my-12">
    <div class="w-full max-w-md">
        <div class="card">
            <div class="p-8">
                <div class="text-center mb-6">
                    <h1 class="text-3xl font-bold text-white">Order Confirmation</h1>
                    <p class="text-gray-400">Please review your order details below.</p>
                </div>

                <hr class="border-gray-700 mb-6" />

                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success text-center">
                        <i class="bi bi-check-circle-fill text-4xl mb-3"></i>
                        <p>@ViewBag.SuccessMessage</p>
                    </div>
                    <a class="btn btn-primary w-full mt-6" asp-controller="ClientOrders" asp-action="Index">
                        <i class="bi bi-receipt-cutoff"></i> View My Orders
                    </a>
                }
                else
                {
                    <div class="space-y-4 text-lg">
                        <div class="flex justify-between">
                            <span class="font-semibold text-gray-400">Delivery Address:</span>
                            <span class="text-right text-white">@ViewBag.DeliveryAddress</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-semibold text-gray-400">Payment Method:</span>
                            <span class="text-right text-white">@ViewBag.PaymentMethod</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-semibold text-gray-400">Total Items:</span>
                            <span class="text-right text-white">@ViewBag.CartSize</span>
                        </div>
                        <div class="flex justify-between items-center pt-4 border-t border-gray-700 mt-4">
                            <span class="text-xl font-bold text-white">Total Amount:</span>
                            <span class="text-2xl font-bold text-amber-400">@ViewBag.Total.ToString("C")</span>
                        </div>
                    </div>

                    <form method="post" class="mt-8">
                        <div class="grid grid-cols-2 gap-4">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> Confirm
                            </button>
                            <a class="btn btn-secondary" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
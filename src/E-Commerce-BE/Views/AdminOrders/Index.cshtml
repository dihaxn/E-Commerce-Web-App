@using E_Commerce_BE.Models
@{
    ViewData["Title"] = "Order Management";
    var orders = ViewBag.Orders as List<Order>;

    var paymentBadges = new Dictionary<string, string>
    {
        { "pending", "badge-warning" },
        { "accepted", "badge-success" },
        { "canceled", "badge-secondary" }
    };
    string GetPaymentBadge(string status) => paymentBadges.GetValueOrDefault(status, "badge-secondary");

    var orderBadges = new Dictionary<string, string>
    {
        { "created", "badge-warning" },
        { "accepted", "badge-success" },
        { "shipped", "badge-info" },
        { "delivered", "badge-success" },
        { "returned", "badge-secondary" },
        { "canceled", "badge-danger" }
    };
    string GetOrderBadge(string status) => orderBadges.GetValueOrDefault(status, "badge-secondary");
}

@section Styles {
    <!-- ADDED: CSS for status badges -->
    <style>
        .badge {
            display: inline-block;
            padding: 0.35em 0.65em;
            font-size: .75em;
            font-weight: 700;
            line-height: 1;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.375rem;
            text-transform: capitalize;
        }

        .badge-success { background-color: rgba(34, 197, 94, 0.2); color: #22c55e; }
        .badge-warning { background-color: rgba(245, 158, 11, 0.2); color: #f59e0b; }
        .badge-danger { background-color: rgba(239, 68, 68, 0.2); color: #ef4444; }
        .badge-info { background-color: rgba(59, 130, 246, 0.2); color: #3b82f6; }
        .badge-secondary { background-color: rgba(107, 114, 128, 0.2); color: #6b7280; }
    </style>
}

<div class="container mx-auto p-4 md:p-8">
    <div class="text-center mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl animate-fade-in-down">
            <i class="bi bi-receipt-cutoff"></i> Order Management
        </h1>
    </div>

    @if (orders == null || !orders.Any())
    {
        <div class="text-center py-16">
            <i class="bi bi-box-seam text-6xl text-gray-600"></i>
            <h3 class="mt-4 text-2xl font-semibold text-white">No Orders Found</h3>
            <p class="mt-2 text-gray-400">There are currently no orders to display.</p>
        </div>
    }
    else
    {
        <!-- CHANGED: Added overflow-x-auto for horizontal scrolling on small screens -->
        <div class="table-container bg-gray-900 rounded-lg shadow-lg overflow-x-auto">
            <!-- CHANGED: Added a min-width to the table to ensure proper spacing -->
            <table class="table w-full text-left text-gray-300 min-w-[1000px]">
                <thead class="bg-gray-800/50 text-gray-400 uppercase text-sm">
                    <tr>
                        <th class="p-3 md:p-4 whitespace-nowrap">ID</th>
                        <th class="p-3 md:p-4 whitespace-nowrap">Client</th>
                        <th class="p-3 md:p-4 whitespace-nowrap">Units</th>
                        <th class="p-3 md:p-4 whitespace-nowrap">Total</th>
                        <th class="p-3 md:p-4 whitespace-nowrap">Payment Method</th>
                        <th class="p-3 md:p-4 whitespace-nowrap">Payment Status</th>
                        <th class="p-3 md:p-4 whitespace-nowrap">Order Status</th>
                        <th class="p-3 md:p-4 whitespace-nowrap">Date</th>
                        <th class="p-3 md:p-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Order order in orders)
                    {
                        int count = order.Items.Sum(item => item.Quantity);
                        decimal total = order.ShippingFee + order.Items.Sum(item => item.Quantity * item.UnitPrice);

                        <tr class="border-t border-gray-700 hover:bg-gray-800/60 transition-colors">
                            <td class="p-3 md:p-4">@order.Id</td>
                            <td class="p-3 md:p-4 whitespace-nowrap">@(order.Client.FirstName + " " + order.Client.LastName)</td>
                            <td class="p-3 md:p-4">@count</td>
                            <td class="p-3 md:p-4 font-semibold whitespace-nowrap">@total.ToString("C")</td>
                            <td class="p-3 md:p-4 whitespace-nowrap">@order.PaymentMethod</td>
                            <td class="p-3 md:p-4 whitespace-nowrap"><span class="badge @GetPaymentBadge(order.PaymentStatus)">@order.PaymentStatus</span></td>
                            <td class="p-3 md:p-4 whitespace-nowrap"><span class="badge @GetOrderBadge(order.OrderStatus)">@order.OrderStatus</span></td>
                            <td class="p-3 md:p-4 whitespace-nowrap">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="p-3 md:p-4">
                                <a class="btn btn-outline btn-sm whitespace-nowrap" asp-controller="AdminOrders" asp-action="Details"
                                   asp-route-id="@order.Id">
                                    <i class="bi bi-pencil-square"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="mt-8" aria-label="Page navigation">
            <ul class="flex justify-center items-center space-x-2">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li>
                        <a class="pagination-link @(i == ViewBag.PageIndex ? "pagination-active" : "")"
                           asp-route-pageIndex="@i">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
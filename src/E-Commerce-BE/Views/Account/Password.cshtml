@model PasswordDto


@{
}

<div class="auth-container">
    <div class="card">
        <div class="card-header">
            <h1 class="card-title">
                <i class="bi bi-shield-lock"></i> Change Password
            </h1>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
        else if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                @ViewBag.SuccessMessage
            </div>
        }

        <div class="p-8">
            <form method="post" class="space-y-6">
                <div class="form-group">
                    <label class="form-label" asp-for="CurrentPassword"></label>
                    <input class="form-input" type="password" asp-for="CurrentPassword"
                        placeholder="Enter your current password">
                    <span asp-validation-for="CurrentPassword" class="input-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="NewPassword"></label>
                    <input class="form-input" type="password" asp-for="NewPassword"
                        placeholder="Enter your new password">
                    <span asp-validation-for="NewPassword" class="input-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input class="form-input" type="password" asp-for="ConfirmPassword"
                        placeholder="Confirm your new password">
                    <span asp-validation-for="ConfirmPassword" class="input-error"></span>
                </div>

                <div class="pt-6 flex flex-col md:flex-row gap-4">
                    <button type="submit" class="btn btn-primary w-full md:w-auto">
                        <i class="bi bi-save"></i> Update Password
                    </button>
                    <a class="btn btn-outline w-full md:w-auto" asp-controller="Account" asp-action="Profile">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@model ProductDto
@{
    ViewData["Title"] = "Create Product";
}

<div class="container mx-auto p-4 md:p-8 max-w-4xl">
    <div class="text-center mb-12">
        <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-6xl animate-fade-in-down">
            <i class="bi bi-plus-circle-dotted"></i> Create New Product
        </h1>
    </div>

    <div class="card">
        <form method="post" enctype="multipart/form-data" class="p-8">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-6">
                    <h5 class="font-bold">Please correct the following errors:</h5>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Name" class="form-label">Product Name*</label>
                        <input asp-for="Name" class="form-input" placeholder="e.g., iPhone 15 Pro">
                        <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
                    </div>
                    <div>
                        <label asp-for="Brand" class="form-label">Brand*</label>
                        <input asp-for="Brand" class="form-input" placeholder="e.g., Apple">
                        <span asp-validation-for="Brand" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Category" class="form-label">Category*</label>
                        <select asp-for="Category" class="form-input">
                            <option value="" disabled selected>Select a category...</option>
                            <option value="Phones">Phones</option>
                            <option value="Computers">Computers</option>
                            <option value="Laptops">Laptops</option>
                            <option value="Accessories">Accessories</option>
                            <option value="Printers">Printers</option>
                            <option value="Cameras">Cameras</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Category" class="text-red-500 text-xs mt-1"></span>
                    </div>
                    <div>
                        <label asp-for="Price" class="form-label">Price*</label>
                        <input asp-for="Price" class="form-input" placeholder="0.00" type="number" step="0.01">
                        <span asp-validation-for="Price" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-input" rows="4" placeholder="Provide a detailed description..."></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="ImageFile" class="form-label">Product Image*</label>
                    <input asp-for="ImageFile" class="form-input" type="file" accept="image/*" onchange="previewImage(event)">
                    <span asp-validation-for="ImageFile" class="text-red-500 text-xs mt-1"></span>
                    <div class="mt-4">
                        <img id="imagePreview" src="#" alt="Image preview" class="hidden max-h-48 rounded-lg border-2 border-dashed border-gray-600 p-2" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-gray-700">
                <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Save Product
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const imagePreview = document.getElementById('imagePreview');
            if (event.target.files && event.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                    imagePreview.classList.remove('hidden');
                };
                reader.readAsDataURL(event.target.files[0]);
            } else {
                imagePreview.src = '#';
                imagePreview.classList.add('hidden');
            }
        }
    </script>
}
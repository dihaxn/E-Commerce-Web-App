@model Order
@{
    ViewData["Title"] = "Order Details";

    string paymentBadgeColor = "bg-red-500/20 text-red-300 border-red-500/50";
    if (Model.PaymentStatus == "pending") paymentBadgeColor = "bg-yellow-500/20 text-yellow-300 border-yellow-500/50";
    else if (Model.PaymentStatus == "accepted") paymentBadgeColor = "bg-green-500/20 text-green-300 border-green-500/50";
    else if (Model.PaymentStatus == "canceled") paymentBadgeColor = "bg-gray-500/20 text-gray-300 border-gray-500/50";

    string orderBadgeColor = "bg-red-500/20 text-red-300 border-red-500/50";
    if (Model.OrderStatus == "created") orderBadgeColor = "bg-yellow-500/20 text-yellow-300 border-yellow-500/50";
    else if (Model.OrderStatus == "accepted") orderBadgeColor = "bg-green-500/20 text-green-300 border-green-500/50";
    else if (Model.OrderStatus == "canceled") orderBadgeColor = "bg-gray-500/20 text-gray-300 border-gray-500/50";
    else if (Model.OrderStatus == "shipped") orderBadgeColor = "bg-blue-500/20 text-blue-300 border-blue-500/50";
    else if (Model.OrderStatus == "delivered") orderBadgeColor = "bg-green-500/20 text-green-300 border-green-500/50";
    else if (Model.OrderStatus == "returned") orderBadgeColor = "bg-indigo-500/20 text-indigo-300 border-indigo-500/50";
    else if (Model.OrderStatus == "deleted") orderBadgeColor = "bg-gray-600/20 text-gray-400 border-gray-600/50";
}

<div class="bg-gradient-to-r from-black via-gray-900 to-black text-white min-h-screen p-4 md:p-8">
    <div class="container mx-auto">
        <a class="inline-flex items-center text-brand-amber hover:text-amber-400 mb-6" asp-controller="ClientOrders" asp-action="Index">
            <i class="bi bi-arrow-left mr-2"></i> Back to Orders
        </a>

        <h3 class="text-3xl font-bold text-center text-white mb-8">Order Details</h3>

        <div class="bg-gray-800/50 rounded-lg shadow-lg p-6 mb-8 border border-gray-700">
            <h4 class="text-2xl font-bold text-white mb-4">Order Information</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                <div><span class="font-semibold text-gray-400">Order ID:</span> @Model.Id</div>
                <div><span class="font-semibold text-gray-400">Order Date:</span> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                <div><span class="font-semibold text-gray-400">Delivery Address:</span> @Model.DeliveryAddress</div>
                <div><span class="font-semibold text-gray-400">Payment Method:</span> @Model.PaymentMethod</div>
                <div>
                    <span class="font-semibold text-gray-400">Payment Status:</span>
                    <span class="px-3 py-1 rounded-full text-xs font-medium border @paymentBadgeColor">@Model.PaymentStatus</span>
                </div>
                <div>
                    <span class="font-semibold text-gray-400">Order Status:</span>
                    <span class="px-3 py-1 rounded-full text-xs font-medium border @orderBadgeColor">@Model.OrderStatus</span>
                </div>
            </div>
        </div>

        <div class="bg-gray-800/50 rounded-lg shadow-lg overflow-hidden border border-gray-700">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-gray-900/70">
                        <tr>
                            <th class="p-4 font-semibold">Product</th>
                            <th class="p-4 font-semibold">Details</th>
                            <th class="p-4 font-semibold text-center">Units</th>
                            <th class="p-4 font-semibold text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal subtotal = 0;
                            foreach (var item in Model.Items)
                            {
                                subtotal += item.UnitPrice * item.Quantity;
                                <tr class="border-b border-gray-700">
                                    <td class="p-4">
                                        <img src="/products/@item.Product.ImageFileName" width="80" class="rounded-lg" alt="..." />
                                    </td>
                                    <td class="p-4">
                                        <a class="text-white hover:text-brand-amber font-semibold" asp-controller="Store"
                                           asp-action="Details" asp-route-id="@item.Product.Id">
                                            @item.Product.Name
                                        </a>
                                        <div class="text-sm text-gray-400">@item.Product.Category</div>
                                        <div class="text-sm text-gray-500">@item.UnitPrice.ToString("C")</div>
                                    </td>
                                    <td class="p-4 text-center">@item.Quantity</td>
                                    <td class="p-4 text-right font-semibold">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex justify-end mt-8">
            <div class="w-full max-w-sm bg-gray-800/50 p-6 rounded-lg border border-gray-700">
                <div class="space-y-2">
                    <div class="flex justify-between">
                        <span class="font-semibold text-gray-400">Subtotal:</span>
                        <span class="text-white">@subtotal.ToString("C")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-semibold text-gray-400">Shipping Fee:</span>
                        <span class="text-white">@Model.ShippingFee.ToString("C")</span>
                    </div>
                    <hr class="border-gray-700 my-2" />
                    <div class="flex justify-between text-xl font-bold">
                        <span class="text-white">Total:</span>
                        <span class="text-brand-amber">@((subtotal + Model.ShippingFee).ToString("C"))</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


